<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ConsumerSmoke</AssemblyName>
    <TargetFrameworkVersion>v2.0</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <Configuration>Release</Configuration>
    <Optimize>true</Optimize>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x86</PlatformTarget>
    <OutputPath>$(ConsumerRoot)\$(PlatformTarget)\</OutputPath>
    <IntermediateOutputPath>$(ConsumerRoot)\obj\$(PlatformTarget)\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <PackageAssembly Include="$(ConsumerRoot)\packages\*\lib\*.dll;$(ConsumerRoot)\packages\*\lib\net20\*.dll" />
    <Reference Include="@(PackageAssembly)">
      <HintPath>%(PackageAssembly.Identity)</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="Program.cs" />
    <None Include="App.config" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(ConsumerRoot)\packages\Microsoft.NETFramework.ReferenceAssemblies.net20.1.0.3\build\Microsoft.NETFramework.ReferenceAssemblies.net20.targets" />
  <Target Name="CopyNativeDependencies" AfterTargets="Build">
    <ItemGroup>
      <NativeDependency Include="$(ConsumerRoot)\packages\SqlServerCompact.4.0.8482.1\NativeBinaries\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeDependency)" DestinationFiles="@(NativeDependency->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
